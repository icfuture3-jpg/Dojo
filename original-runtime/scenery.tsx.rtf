/** Themed backdrops for the rescue dojos, drawn over the dojo wall. Index matches RESCUES. */\
const bamboo = (x: number, h: number, s: number): ReactNode => (\
  <g key=\{x\}>\
    <rect x=\{x\} y=\{435 - h\} width=\{s\} height=\{h\} fill="#3f8f3a" stroke="#1d5a1f" strokeWidth="2" />\
    \{Array.from(\{ length: Math.floor(h / 60) \}, (_, i) => <rect key=\{i\} x=\{x - 2\} y=\{435 - 60 * (i + 1)\} width=\{s + 4\} height="6" fill="#2a6e2b" />)\}\
    <path d=\{`M$\{x + s\} $\{435 - h * 0.6\} q60 -20 90 10 q-50 0 -90 -4 M$\{x\} $\{435 - h * 0.8\} q-60 -20 -90 10 q50 0 90 -4`\} fill="#6cc04a" stroke="#2a6e2b" />\
  </g>\
);\
\
