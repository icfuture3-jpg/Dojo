export const SCENE_FLOOR = ["#2f6a2a", "#2f6a8a", "#555e68", "#c9b88a", "#3b2f5a", "#3a2a5a"];\
\
export function RescueScenery(\{ i \}: \{ i: number \}): ReactNode \{\
  const k = Math.max(0, Math.min(5, i));\
  return (\
    <div style=\{\{ position: "absolute", inset: 0, pointerEvents: "none" \}\}>\
      <svg viewBox="0 0 1280 435" preserveAspectRatio="none" style=\{\{ position: "absolute", left: 0, top: 0, width: "100%", height: "60.4%" \}\}><ScenicWall i=\{k\} /></svg>\
      <div style=\{\{ position: "absolute", left: 0, right: 0, top: "60.4%", bottom: 0, background: `linear-gradient(#0000, #0006), $\{SCENE_FLOOR[k]\}`, opacity: 0.55, mixBlendMode: "multiply" \}\} />\
    </div>\
  );\
\}}