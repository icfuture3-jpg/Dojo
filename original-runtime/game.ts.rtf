import \{ defineGame, defineProtocol \} from "@trhs/wildwood";\
import \{ z \} from "zod";\
\
export const MatchDone = z.object(\{\
  rival: z.number(),\
  won: z.boolean(),\
  roundsWon: z.number(),\
  roundsLost: z.number(),\
  comeback: z.boolean(),\
  perfectRun: z.boolean(),\
\});\
export const ModeDone = z.object(\{\
  mode: z.enum(["tower", "daily", "spectate", "rescue"]),\
  floor: z.number(),\
  won: z.boolean(),\
  correct: z.boolean(),\
\});\
const ItemId = z.object(\{ id: z.string() \});\
export const LookData = z.object(\{\
  body: z.number(), head: z.number(), hair: z.number(), hairColor: z.number(), eye: z.number(),\
  eyeColor: z.number(), skin: z.number(), pattern: z.number(), outfit: z.number(),\
\});\
\
export const DojoProtocol = defineProtocol("dojo", \{\
  toServer: \{\
    matchDone: MatchDone,\
    modeDone: ModeDone,\
    buyItem: ItemId,\
    equip: ItemId,\
    setLook: LookData,\
    buyUpgrade: ItemId,\
    openBox: z.object(\{ currency: z.enum(["coins", "gems"]) \}),\
    setName: z.object(\{ name: z.string() \}),\
    refreshBoard: z.object(\{ at: z.number() \}),\
  \},\
  toClient: \{\
    /** The player's progression as JSON (see economy.ts). */\
    profile: z.object(\{ data: z.string() \}),\
    /** Top fighters as JSON, and the id this player is listed under. */\
    board: z.object(\{ data: z.string(), id: z.string() \}),\
  \},\
\});\
\
export const game = defineGame(\{ name: "Dojo of the Three Hands", tickRate: 10, protocols: [DojoProtocol] \});}