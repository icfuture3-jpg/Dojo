    <Frame title="Create your fighter" onClose=\{onClose\} p=\{p\}>\
      <div style=\{\{ display: "flex", gap: 24, flexWrap: "wrap" \}\}>\
        <div style=\{\{ width: 230, display: "flex", flexDirection: "column", alignItems: "center", gap: 10 \}\}>\
          <div style=\{\{ transform: "scale(0.85)", transformOrigin: "top center", height: 270 \}\}>\{preview(look)\}</div>\
          <button type="button" style=\{small\} onClick=\{randomize\}>\uc0\u55356 \u57266  SURPRISE ME</button>\
          <div style=\{\{ fontSize: 12, opacity: 0.7, textAlign: "center" \}\}>\
            \{OUTFIT_COUNT\} outfits \'b7 \{LOOK_COUNTS.hair\} hairstyles \'b7 \{LOOK_COUNTS.hairColor\} hair colours \'b7 \{LOOK_COUNTS.eye\} eye shapes \'b7 \{LOOK_COUNTS.eyeColor\} eye colours \'b7 \{LOOK_COUNTS.head\} head shapes \'b7 \{total.toLocaleString()\}+ faces\
          </div>\
        </div>\
        <div style=\{\{ flex: 1, minWidth: 300 \}\}>\
          <div style=\{\{ display: "flex", gap: 8, marginBottom: 12, flexWrap: "wrap" \}\}>\
            \{LOOK_TABS.map((t) => (\
              <button key=\{t.id\} type="button" style=\{\{ ...small, background: tab === t.id ? "#c0392b" : "#3a2210" \}\} onClick=\{() => setTab(t.id)\}>\{t.label\}</button>\
            ))\}\
          </div>\
          <div style=\{\{ display: "flex", gap: 8, flexWrap: "wrap", alignItems: "center", marginBottom: 12 \}\}>\
            <span style=\{\{ fontSize: 14, opacity: 0.8 \}\}>Master looks (beat them to unlock):</span>\
            \{MASTER_LOOKS.map((m, i) => \{\
              const open = p.beaten.includes(i);\
              return (\
                <button key=\{m.name\} type="button" disabled=\{!open\} style=\{open ? small : disabledBtn\} onClick=\{() => \{ const next = \{ ...m.look, pattern: patternMinLevel(m.look.pattern) <= level ? m.look.pattern : 0 \}; setLook(next); dispatch(\{ type: "dojo.send", message: setLookMsg(next) \}); \}\}>\
                  \{open ? m.name : `\uc0\u55357 \u56594  $\{m.name\}`\}\
                </button>\
              );\
            \})\}\
          </div>\
          <div style=\{\{ display: "flex", gap: 8, flexWrap: "wrap" \}\}>\
            \{tab === "outfit" && (\
              <button type="button" style=\{\{ ...small, background: look.outfit === -1 ? "#1e8449" : "#3a2210" \}\} onClick=\{() => choose("outfit", -1)\}>Shop gi</button>\
            )\}\
            \{names?.map((n, i) => \{\
              const locked = tab === "pattern" && level < patternMinLevel(i);\
              return (\
                <button key=\{n\} type="button" disabled=\{locked\} style=\{locked ? disabledBtn : \{ ...small, background: look[tab] === i ? "#1e8449" : "#3a2210" \}\} onClick=\{() => choose(tab, i)\}>\
                  \{locked ? `\uc0\u55357 \u56594  Lv $\{patternMinLevel(i)\}` : n\}\
                </button>\
              );\
            \})\}\
            \{sw?.map((c, i) => (\
              <button key=\{c\} type="button" aria-label=\{`$\{tab\} colour $\{i + 1\}`\} onClick=\{() => choose(tab, i)\} style=\{\{ width: 40, height: 40, borderRadius: 8, background: c, cursor: "pointer", pointerEvents: "auto", border: look[tab] === i ? "4px solid #2ecc71" : "2px solid #fff6" \}\} />\
            ))\}\
          </div>\
        </div>\
      </div>\
    </Frame>\
  );\
\}}