import type \{ PresentationContext \} from "@trhs/wildwood/client";\
import type \{ z \} from "zod";\
import \{ DojoProtocol, type LookData, type MatchDone, type ModeDone \} from "./game";\
\
type Send = PresentationContext["send"];\
\
/** A message to the server, ready to be sent by whoever holds the connection. */\
export type Outgoing = \{ send(send: Send): void \};\
export type DojoEvent = \{ type: "dojo.send"; message: Outgoing \};\
\
const to = DojoProtocol.toServer;\
const out = <T>(m: Parameters<Send>[0], data: T): Outgoing => (\{ send: (send) => (send as (m: unknown, d: unknown) => void)(m, data) \});\
\
export const matchDone = (d: z.infer<typeof MatchDone>) => out(to.matchDone, d);\
export const modeDoneMsg = (d: z.infer<typeof ModeDone>) => out(to.modeDone, d);\
export const buyItemMsg = (d: \{ id: string \}) => out(to.buyItem, d);\
export const equipItemMsg = (d: \{ id: string \}) => out(to.equip, d);\
export const setLookMsg = (d: z.infer<typeof LookData>) => out(to.setLook, d);\
export const buyUpgradeMsg = (d: \{ id: string \}) => out(to.buyUpgrade, d);\
export const openBoxMsg = (d: \{ currency: "coins" | "gems" \}) => out(to.openBox, d);\
export const setNameMsg = (d: \{ name: string \}) => out(to.setName, d);\
export const refreshBoardMsg = (d: \{ at: number \}) => out(to.refreshBoard, d);}